{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "exam.schema.json",
  "title": "Exam Configuration",
  "description": "Schema for exams/<slug>/exam.json - exam settings and configuration",
  "type": "object",
  "required": ["slug", "code", "name", "vendor", "domains", "scoring"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-friendly folder name"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Exam code, e.g. AZ-104, 220-1201"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full exam name"
    },
    "vendor": {
      "type": "string",
      "description": "Certification vendor: Microsoft, AWS, CompTIA, Cisco, Google Cloud, Salesforce, Red Hat, NHA, AAPC, Linux Professional Institute"
    },
    "legacyStorageKey": {
      "type": "string",
      "description": "Legacy localStorage key for backward compatibility"
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "pct"],
        "properties": {
          "name": { "type": "string", "description": "Domain name" },
          "weight": { "type": "string", "pattern": "^\\d+–\\d+%$", "description": "Display weight range" },
          "pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Weight as percentage" }
        }
      },
      "minProperties": 1
    },
    "scoring": {
      "type": "object",
      "required": ["min", "max", "pass"],
      "properties": {
        "min": { "type": "number", "minimum": 0, "description": "Minimum scaled score" },
        "max": { "type": "number", "minimum": 1, "description": "Maximum scaled score" },
        "pass": { "type": "number", "minimum": 0, "description": "Passing score" }
      }
    },
    "minutesPerQuestion": {
      "type": "number",
      "minimum": 0.5,
      "description": "Average minutes per question (affects exam timer)"
    },
    "defaultSize": {
      "type": "number",
      "minimum": 10,
      "description": "Default question count for timed exam"
    },
    "sizeOptions": {
      "type": "array",
      "items": { "type": "number", "minimum": 5 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Available question count options"
    },
    "realExamNote": {
      "type": "string",
      "description": "Note about real exam format"
    },
    "scoreNote": {
      "type": "string",
      "description": "Note about scoring differences"
    },
    "questions": {
      "type": "number",
      "minimum": 0,
      "description": "Number of questions (optional, can be computed)"
    },
    "labs": {
      "type": "number",
      "minimum": 0,
      "description": "Number of hands-on labs"
    },
    "learning": {
      "type": "boolean",
      "description": "Whether this exam has learning path content"
    },
    "learningModules": {
      "type": "number",
      "minimum": 1,
      "description": "Number of learning modules if learning is enabled"
    }
  }
}