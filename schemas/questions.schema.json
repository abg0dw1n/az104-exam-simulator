{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "questions.schema.json",
  "title": "Questions Bank",
  "description": "Schema for exams/<slug>/questions.json - exam question bank",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "domain", "scenario", "options", "answer", "explanation"],
    "properties": {
      "id": {
        "type": "number",
        "minimum": 1,
        "description": "Unique question ID"
      },
      "domain": {
        "type": "string",
        "pattern": "^D\\d+$",
        "description": "Domain identifier (e.g. D1, D2)"
      },
      "scenario": {
        "type": "string",
        "minLength": 1,
        "description": "Question scenario/prompt, can contain HTML"
      },
      "options": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Option text, can contain HTML"
            },
            "note": {
              "type": "string",
              "default": "",
              "description": "Explanation note for this option"
            }
          }
        },
        "minItems": 2,
        "description": "Answer options"
      },
      "answer": {
        "type": "number",
        "minimum": 0,
        "description": "Zero-based index of the correct answer"
      },
      "explanation": {
        "type": "string",
        "minLength": 1,
        "description": "Explanation for the answer, can contain HTML"
      },
      "hint": {
        "type": "string",
        "description": "Optional hint for the question"
      }
    }
  }
}