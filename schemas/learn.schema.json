{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "learn.schema.json",
  "title": "Learning Path Configuration",
  "description": "Schema for exams/<slug>/learn.json - learning path content",
  "type": "object",
  "required": ["modules"],
  "properties": {
    "intro": {
      "type": "string",
      "description": "Introductory text for the learning path"
    },
    "narration": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": {
          "type": "string",
          "description": "URL template for narration audio files (supports {id} and {n} placeholders)"
        },
        "perSlide": {
          "type": "boolean",
          "default": false,
          "description": "Whether each slide needs its own audio file"
        },
        "credit": {
          "type": "string",
          "description": "Credit for the voice/producer"
        }
      }
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Last updated date (YYYY-MM-DD)"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "note": { "type": "string" }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "guide"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D\\d+$",
            "description": "Module ID matching domain (D1, D2, etc.)"
          },
          "short": {
            "type": "string",
            "description": "Short name for the module"
          },
          "title": {
            "type": "string",
            "description": "Full module title"
          },
          "summary": {
            "type": "string",
            "description": "Module summary text"
          },
          "guide": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["h", "html"],
              "properties": {
                "h": { "type": "string", "description": "Section heading" },
                "html": { "type": "string", "description": "HTML content" }
              }
            },
            "description": "Study guide sections"
          },
          "slides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "html": { "type": "string" }
              }
            },
            "description": "Slideshow content"
          },
          "tips": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Key tips for the module"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string" }
            },
            "description": "Term-definition pairs"
          }
        }
      }
    }
  }
}