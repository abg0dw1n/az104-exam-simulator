        {
          "text": "Turn off WPS",
          "check": {
            "field": "wifi.wps",
            "eq": false
          }
        },
        {
          "text": "Replace the default admin password (12+ characters)",
          "check": {
            "all": [
              {
                "field": "admin.pass",
                "minLen": 12
              },
              {
                "field": "admin.pass",
                "ne": "admin"
              }
