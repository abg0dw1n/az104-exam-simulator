            "tables": [
              {
                "id": "rules",
                "title": "Port forwarding rules",
                "columns": [
                  {
                    "id": "name",
                    "label": "Name"
                  },
                  {
                    "id": "proto",
                    "label": "Protocol",
                    "type": "select",
                    "options": [
